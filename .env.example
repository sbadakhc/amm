# Postgres connection used by schema.sql / generate_synthetic_data.py and the workflow poller
DATABASE_URL=postgresql://user:pass@localhost:5432/moderator

# NVIDIA NIM API key for the Safety/Evidence/Consistency Agents' model calls
# Get one at https://build.nvidia.com
NVIDIA_API_KEY=

# S3 image storage (images.py, §3.1). Leave S3_ENDPOINT_URL unset to use real AWS S3
# with its default credential/endpoint resolution. Set it to point at a
# self-hosted S3-compatible store instead, e.g. MinIO via scripts/dev-minio.sh:
#   S3_ENDPOINT_URL=http://127.0.0.1:59000
#   AWS_ACCESS_KEY_ID=amm
#   AWS_SECRET_ACCESS_KEY=amm12345
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Decision/Policy Agent thresholds (§4, §3.5) -- configurable, not hard-coded.
# Uncomment to override; defaults shown. Read once at process start (module import),
# so changing these requires restarting service.py / the process that imported them.
# CRITICAL_REJECT_THRESHOLD=0.95
# AUTO_APPROVE_THRESHOLD=0.90
# SELLER_HISTORY_ADJUSTMENT_PER_VIOLATION=0.05
# SELLER_HISTORY_ADJUSTMENT_CAP=0.20
# CONSISTENCY_THRESHOLD=0.30

# Default moderatorId for cli/tools.py's approve_listing/reject_listing/record_decision
# (§6) when not passed explicitly -- like git's user.name. Still validated against the
# moderators table (must exist and be active); this is just a default, not a bypass.
MODERATOR_ID=mod-1
