# Postgres connection used by schema.sql / generate_synthetic_data.py and the workflow poller
DATABASE_URL=postgresql://user:pass@localhost:5432/moderator

# NVIDIA NIM API key for the Safety/Evidence/Consistency Agents' model calls
# Get one at https://build.nvidia.com
NVIDIA_API_KEY=

# S3 image storage (images.py, §3.1). Leave S3_ENDPOINT_URL unset to use real AWS S3
# with its default credential/endpoint resolution. Set it to point at a
# self-hosted S3-compatible store instead, e.g. MinIO via scripts/dev-minio.sh:
#   S3_ENDPOINT_URL=http://127.0.0.1:59000
#   AWS_ACCESS_KEY_ID=amm
#   AWS_SECRET_ACCESS_KEY=amm12345
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
